// Gerado por scripts/sync_welcome_email.py; editar xano/templates/welcome_email.*.
function "Notifications/render_welcome_email" {
  input { text name
    text profile }
  stack {
    api.lambda {
      code = """
const config={"brand_color": "#0d403a", "text_color": "#17332c", "davi_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/b42d19ced00e15fb04ef612a2c176919b66be7dd/email/developers/davi-diniz.jpeg", "vitor_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/491b6b77173e105b76a9082990c35fa591ca4d69/email/developers/vitor-sousa.png", "danikelly_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/d9684c01dec861e10d8308f03ad4134d19f9b0ca/email/developers/danikelly-alves.png", "background_color": "#4c5c34", "clinic_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/0d062f022b868b62338b6f82307ba6469a4f0994/email/welcome-clinicturtle.jpeg", "title": "Que bom ter você no Vet Tech!", "profiles": {"tutor": {"subject": "Seu melhor amigo ganhou mais cuidado | Vet Tech", "profile_label": "PARA QUEM CUIDA COM AMOR", "intro": "Obrigado por escolher o Vet Tech para acompanhar o cuidado do seu melhor amigo! Sua conta de tutor já está pronta para começar.", "step_one": "Cadastre seus pets e mantenha as informações deles organizadas.", "step_two": "Acompanhe vacinas, medicamentos, consultas e registros disponíveis no sistema.", "step_three": "Compartilhe o acesso ao prontuário com um veterinário quando desejar autorizar esse cuidado.", "closing": "Cada cuidado faz diferença. Estamos felizes por acompanhar você e seus pets nessa jornada!"}, "veterinario": {"subject": "Obrigado por fazer parte do nosso cuidado | Vet Tech", "profile_label": "PARA QUEM TRANSFORMA CUIDADO EM PROFISSÃO", "intro": "Obrigado por fazer parte do Vet Tech e contribuir para o cuidado dos nossos melhores amigos! Sua conta de veterinário já está pronta para começar.", "step_one": "Organize seus horários e acompanhe a agenda de consultas.", "step_two": "Acompanhe seus atendimentos e mantenha os registros profissionais organizados.", "step_three": "Consulte prontuários somente com a autorização concedida pelos tutores.", "closing": "Seu conhecimento faz parte de um cuidado que aproxima pessoas e pets. Que bom ter você com a gente!"}}, "background_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/e54c1843e9407b3e32571fd298509825a21e3d68/email/welcome-fundo.webp", "mascot_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/0580aad550d98e547de77501c3f5bc26f031864a/email/welcome-mascote-v-clean.png", "header_color": "#526b35", "system_url": "http://localhost:3000/login"};
const template="<!doctype html>\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{title}}</title></head>\n<body style=\"margin:0;padding:0;background:{{background_color}};color:{{text_color}};font-family:Arial,Helvetica,sans-serif;\">\n<div style=\"display:none;max-height:0;overflow:hidden;\">Sua conta no Vet Tech está pronta. Obrigado por fazer parte desse cuidado!</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"{{background_color}}\" background=\"{{background_image_url}}\" style=\"background-image:url('{{background_image_url}}');background-size:cover;background-position:center top;background-repeat:no-repeat;\"><tr><td align=\"center\" style=\"padding:32px 12px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border:2px solid #93b5a0;border-radius:24px;overflow:hidden;\">\n<tr><td align=\"center\" bgcolor=\"{{header_color}}\" style=\"padding:18px 18px 0;background:{{header_color}};border-radius:20px 20px 0 0;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:360px;\"><tr>\n<td width=\"124\" valign=\"bottom\" style=\"padding-right:14px;font-size:0;line-height:0;\"><img src=\"{{mascot_image_url}}\" width=\"110\" alt=\"Tartaruga Vet Tech com os braços em V.\" style=\"display:block;width:110px;max-width:100%;height:auto;border:0;margin-bottom:-1.7px;\"></td>\n<td valign=\"middle\" style=\"text-align:left;padding-bottom:22px;\"><p style=\"margin:0 0 6px;color:#fff9e7;font-size:30px;font-weight:bold;letter-spacing:1px;\">Vet Tech</p>\n<p style=\"margin:0;color:#fff9e7;font-size:14px;line-height:1.5;\">Cuidado que acompanha você.</p></td>\n</tr></table></td></tr>\n<tr><td style=\"padding:28px 24px 20px;\">\n<p style=\"margin:0 0 12px;text-align:center;font-size:11px;font-weight:bold;line-height:1.6;letter-spacing:1px;color:{{brand_color}};\">{{profile_label}}</p>\n<h1 style=\"margin:0 0 22px;text-align:center;font-size:27px;line-height:1.3;color:{{brand_color}};\">{{title}}</h1>\n<img src=\"{{clinic_image_url}}\" width=\"548\" alt=\"Tartaruga Vet Tech cuidando de animais em uma clínica veterinária.\" style=\"display:block;width:100%;max-width:548px;height:auto;border:0;border-radius:14px;\">\n<p style=\"margin:24px 0 12px;font-size:18px;line-height:1.5;font-weight:bold;color:{{brand_color}};\">Olá, {{name}}!</p>\n<p style=\"margin:0 0 22px;font-size:16px;line-height:1.7;\">{{intro}}</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#f2f6ee\" style=\"border:1px solid #d9e5d4;border-radius:14px;\"><tr><td style=\"padding:20px 18px;\">\n<h2 style=\"margin:0 0 14px;font-size:18px;line-height:1.4;color:{{brand_color}};\">Seus próximos passos</h2>\n<p style=\"margin:0 0 12px;font-size:15px;line-height:1.65;\"><strong style=\"color:{{brand_color}};\">1.</strong> {{step_one}}</p>\n<p style=\"margin:0 0 12px;font-size:15px;line-height:1.65;\"><strong style=\"color:{{brand_color}};\">2.</strong> {{step_two}}</p>\n<p style=\"margin:0;font-size:15px;line-height:1.65;\"><strong style=\"color:{{brand_color}};\">3.</strong> {{step_three}}</p>\n</td></tr></table>\n<p style=\"margin:20px 0;font-size:15px;line-height:1.7;\">Para começar, acesse sua conta com o e-mail e a senha que você cadastrou.</p>\n<table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 auto 24px;\"><tr><td align=\"center\" bgcolor=\"{{header_color}}\" style=\"border-radius:999px;\">\n<a href=\"{{system_url}}\" target=\"_blank\" style=\"display:inline-block;padding:14px 24px;color:#fff9e7;background:{{header_color}};border-radius:999px;font-size:16px;line-height:1.4;font-weight:bold;text-decoration:none;text-align:center;\">Acesse nosso sistema</a>\n</td></tr></table>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:1.7;\">{{closing}}</p>\n<p style=\"margin:0;text-align:center;font-size:17px;line-height:1.5;font-weight:bold;color:{{brand_color}};\">O melhor sistema para seu melhor amigo!</p>\n</td></tr>\n<tr><td style=\"padding:22px 24px 28px;border-top:1px solid #d9e5d4;\">\n<h2 style=\"margin:0 0 18px;text-align:center;color:{{brand_color}};font-size:18px;line-height:1.5;\">Desenvolvedores do Sistema:</h2>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"table-layout:fixed;\">\n                <tr>\n                  <td width=\"33%\" align=\"center\" valign=\"middle\" style=\"padding:0 4px 10px;\">\n                    <img src=\"{{davi_image_url}}\" width=\"120\" alt=\"Davi Diniz\" style=\"display:block;width:100%;max-width:120px;height:auto;border:2px solid #72aaa0;border-radius:18px;box-sizing:border-box;\">\n                  </td>\n                  <td width=\"34%\" align=\"center\" valign=\"middle\" style=\"padding:0 4px 10px;\">\n                    <img src=\"{{vitor_image_url}}\" width=\"120\" alt=\"Vitor Sousa\" style=\"display:block;width:100%;max-width:120px;height:auto;border:2px solid #72aaa0;border-radius:18px;box-sizing:border-box;\">\n                  </td>\n                  <td width=\"33%\" align=\"center\" valign=\"middle\" style=\"padding:0 4px 10px;\">\n                    <img src=\"{{danikelly_image_url}}\" width=\"120\" alt=\"Danikelly Alves\" style=\"display:block;width:100%;max-width:120px;height:auto;border:2px solid #72aaa0;border-radius:18px;box-sizing:border-box;\">\n                  </td>\n                </tr>\n                <tr>\n                  <td align=\"center\" valign=\"top\" style=\"padding:0 4px;color:{{brand_color}};font-size:13px;font-weight:bold;line-height:1.5;\">Davi Diniz</td>\n                  <td align=\"center\" valign=\"top\" style=\"padding:0 4px;color:{{brand_color}};font-size:13px;font-weight:bold;line-height:1.5;\">Vitor Sousa</td>\n                  <td align=\"center\" valign=\"top\" style=\"padding:0 4px;color:{{brand_color}};font-size:13px;font-weight:bold;line-height:1.5;\">Danikelly Alves</td>\n                </tr>\n              </table>\n<p style=\"margin:24px 0 0;text-align:center;font-size:13px;line-height:1.6;color:#52635a;\">Com carinho,<br><strong style=\"color:{{brand_color}};\">Vet Tech Team</strong></p>\n</td></tr></table>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;margin-top:18px;background:{{header_color}};border-radius:14px;\"><tr><td bgcolor=\"{{header_color}}\" style=\"padding:16px 12px;border-radius:14px;\">\n<p style=\"margin:0;font-size:12px;line-height:1.7;text-align:center;color:#fff9e7;\">Vet Tech · Cuidado que acompanha você.<br>Esta é uma mensagem automática de boas-vindas.</p>\n<p style=\"margin:10px 0 0;font-size:12px;line-height:1.6;text-align:center;color:#fff9e7;\">Copyright © by Vet Tech Team</p>\n</td></tr></table>\n</td></tr></table></body></html>\n";
const plain="Vet Tech — Cuidado que acompanha você.\n\n{{title}}\nOlá, {{name}}!\n\n{{intro}}\n\nSeus próximos passos\n1. {{step_one}}\n2. {{step_two}}\n3. {{step_three}}\n\nPara começar, acesse sua conta com o e-mail e a senha que você cadastrou.\nAcesse nosso sistema: {{system_url}}\n\n{{closing}}\nO melhor sistema para seu melhor amigo!\n\nDesenvolvedores do Sistema:\nDavi Diniz · Vitor Sousa · Danikelly Alves\n\nCom carinho,\nVet Tech Team\nEsta é uma mensagem automática de boas-vindas.\nCopyright © by Vet Tech Team\n";
const p=$input;
if(!Object.hasOwn(config.profiles,p.profile)||typeof p.name!=='string'||!p.name.trim()||p.name.length>500)throw Error('Mensagem inválida.');
for(const k of ['brand_color','background_color','text_color','header_color'])if(!/^#[0-9a-fA-F]{6}$/.test(config[k]))throw Error('Cor inválida.');
for(const k of ['clinic_image_url','davi_image_url','vitor_image_url','danikelly_image_url','background_image_url','mascot_image_url'])if(!/^https:\/\/[a-z0-9.-]+(?::[0-9]+)?\/[^\s"<>]*$/i.test(config[k]))throw Error('Imagem inválida.');
if(config.system_url!=='http://localhost:3000/login'&&!/^https:\/\/[a-z0-9.-]+(?::[0-9]+)?\/[^\s"<>]*$/i.test(config.system_url))throw Error('URL do sistema inválida.');
const values={...config,...config.profiles[p.profile],name:p.name.trim()};
const escape=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#x27;'}[c]));
const render=(source,safe)=>source.replace(/\{\{([a-z_]+)\}\}/g,(_,key)=>{if(typeof values[key]!=='string')throw Error('Variável inválida.');return safe?escape(values[key]):values[key];});
return {subject:values.subject,html:render(template,true),text:render(plain,false)};
      """
      timeout = 5
    } as $message
  }
  response = $message
  history = false
  tags = ["vettech", "welcome-email"]
}
