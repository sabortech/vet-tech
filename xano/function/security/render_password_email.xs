// Gerado por scripts/sync_password_email.py; editar xano/templates/.
function "Security/render_password_email" {
  input {
    text purpose
    text code
    int validity_minutes
  }
  stack {
    api.lambda {
      code = """
const config = {"brand_color": "#0d403a", "background_color": "#0d403a", "text_color": "#17332c", "purposes": {"change": {"subject": "Confirme a alteração da sua senha | Vet Tech", "title": "Confirme a alteração da sua senha", "intro": "Recebemos uma solicitação para alterar a senha da sua conta. Para continuar, confirme seu e-mail usando o código abaixo."}, "reset": {"subject": "Recupere seu acesso ao Vet Tech!", "title": "Recupere seu acesso ao Vet Tech!", "intro": "Vamos ajudar você a voltar à sua conta. Use o código abaixo para confirmar seu e-mail e, em seguida, escolha uma nova senha."}}, "header_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/9643e2bb25f3fd8eac336cb543d037151082f85a/email/password-email-header.jpg", "footer_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/cac7044aadf49b8153492ef297eb91ccb600814a/email/password-email-pets.jpg", "davi_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/b42d19ced00e15fb04ef612a2c176919b66be7dd/email/developers/davi-diniz.jpeg", "vitor_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/491b6b77173e105b76a9082990c35fa591ca4d69/email/developers/vitor-sousa.png", "danikelly_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/d9684c01dec861e10d8308f03ad4134d19f9b0ca/email/developers/danikelly-alves.png", "ocean_image_url": "https://raw.githubusercontent.com/7offdvx/vet-tech-assets/cd2b6d5983bd4306a193caaab59603765497f14f/email/password-email-ocean.jpeg"};
const template = "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>{{title}}</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:{{background_color}};color:{{text_color}};font-family:Arial,Helvetica,sans-serif;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;\">Use o código para confirmar sua solicitação no Vet Tech. Válido por {{validity_minutes}} minutos.</div>\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" background=\"{{ocean_image_url}}\" style=\"background-color:{{background_color}};background-image:url('{{ocean_image_url}}');background-position:center top;background-size:cover;background-repeat:no-repeat;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background-color:#ffffff;border:3px solid #72aaa0;border-radius:22px;border-spacing:0;overflow:hidden;\">\n        <tr><td style=\"padding:0;background-color:{{brand_color}};border-radius:18px 18px 0 0;\">\n          <img src=\"{{header_image_url}}\" width=\"594\" alt=\"Vet Tech — Cuidado que acompanha você.\" style=\"display:block;width:100%;max-width:594px;height:auto;border:0;border-radius:18px 18px 0 0;color:#ffffff;font-size:24px;font-weight:bold;text-align:center;\">\n        </td></tr>\n        <tr><td style=\"padding:28px 24px 12px;\">\n          <p style=\"margin:0 0 10px;text-align:center;color:{{brand_color}};font-size:12px;font-weight:bold;letter-spacing:1px;\">SEGURANÇA DA SUA CONTA</p>\n          <h1 style=\"margin:0 0 20px;text-align:center;font-size:25px;line-height:1.3;color:{{brand_color}};\">{{title}}</h1>\n          <p style=\"margin:0 0 24px;font-size:16px;line-height:1.6;\">{{intro}}</p>\n          <p style=\"margin:0 0 10px;font-size:14px;line-height:1.5;\">Seu código de verificação:</p>\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" bgcolor=\"{{background_color}}\" style=\"padding:20px 8px;background-color:{{background_color}};border:2px dashed #72aaa0;border-radius:12px;\">\n            <p style=\"margin:0;color:#ffffff;font-family:Consolas,Monaco,monospace;font-size:32px;font-weight:bold;letter-spacing:6px;line-height:1.4;\">{{code}}</p>\n          </td></tr></table>\n          <p style=\"margin:14px 0 24px;font-size:14px;line-height:1.6;\">Este código é válido por <strong style=\"color:{{brand_color}};\">{{validity_minutes}} minutos</strong> e pode ser usado uma única vez. Digite-o na tela do Vet Tech onde você fez a solicitação.</p>\n          <p style=\"margin:0 0 24px;font-size:14px;line-height:1.6;\"><strong style=\"color:{{brand_color}};\">Não compartilhe este código.</strong> Nossa equipe nunca pede sua senha ou seu código de verificação por mensagem.</p>\n        </td></tr>\n        <tr><td style=\"padding:0 24px 28px;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-top:1px solid #bdd8d1;\">\n            <tr><td style=\"padding-top:20px;padding-bottom:20px;\">\n              <p style=\"margin:0 0 16px;text-align:center;color:{{brand_color}};font-size:18px;font-weight:bold;line-height:1.5;\">O melhor sistema para seu melhor amigo!</p>\n              <img src=\"{{footer_image_url}}\" width=\"546\" alt=\"Cachorro, gato e coelho em uma clínica veterinária.\" style=\"display:block;width:100%;max-width:546px;height:auto;border:0;border-radius:12px;\">\n            </td></tr>\n            <tr><td style=\"padding-bottom:24px;\">\n              <h2 style=\"margin:0 0 18px;text-align:center;color:{{brand_color}};font-size:18px;line-height:1.5;\">Desenvolvedores do Sistema:</h2>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"table-layout:fixed;\">\n                <tr>\n                  <td width=\"33%\" align=\"center\" valign=\"middle\" style=\"padding:0 4px 10px;\">\n                    <img src=\"{{davi_image_url}}\" width=\"120\" alt=\"Davi Diniz\" style=\"display:block;width:100%;max-width:120px;height:auto;border:2px solid #72aaa0;border-radius:18px;box-sizing:border-box;\">\n                  </td>\n                  <td width=\"34%\" align=\"center\" valign=\"middle\" style=\"padding:0 4px 10px;\">\n                    <img src=\"{{vitor_image_url}}\" width=\"120\" alt=\"Vitor Sousa\" style=\"display:block;width:100%;max-width:120px;height:auto;border:2px solid #72aaa0;border-radius:18px;box-sizing:border-box;\">\n                  </td>\n                  <td width=\"33%\" align=\"center\" valign=\"middle\" style=\"padding:0 4px 10px;\">\n                    <img src=\"{{danikelly_image_url}}\" width=\"120\" alt=\"Danikelly Alves\" style=\"display:block;width:100%;max-width:120px;height:auto;border:2px solid #72aaa0;border-radius:18px;box-sizing:border-box;\">\n                  </td>\n                </tr>\n                <tr>\n                  <td align=\"center\" valign=\"top\" style=\"padding:0 4px;color:{{brand_color}};font-size:13px;font-weight:bold;line-height:1.5;\">Davi Diniz</td>\n                  <td align=\"center\" valign=\"top\" style=\"padding:0 4px;color:{{brand_color}};font-size:13px;font-weight:bold;line-height:1.5;\">Vitor Sousa</td>\n                  <td align=\"center\" valign=\"top\" style=\"padding:0 4px;color:{{brand_color}};font-size:13px;font-weight:bold;line-height:1.5;\">Danikelly Alves</td>\n                </tr>\n              </table>\n            </td></tr>\n            <tr><td>\n              <p style=\"margin:0;text-align:center;font-size:13px;line-height:1.6;\">Não foi você? Ignore este e-mail. Esta solicitação, por si só, não altera sua senha.</p>\n            </td></tr>\n          </table>\n        </td></tr>\n      </table>\n      <p style=\"max-width:540px;margin:20px 12px 0;color:#ffffff;font-size:12px;line-height:1.6;text-align:center;\">Vet Tech · Segurança e cuidado em cada etapa.<br>Esta é uma mensagem automática.</p>\n      <p style=\"margin:10px 12px 0;color:#ffffff;font-size:12px;line-height:1.6;text-align:center;\">Copyright © by Vet Tech Team</p>\n    </td></tr>\n  </table>\n</body>\n</html>\n";
const plain = "Vet Tech — Segurança da sua conta\n\n{{title}}\n\n{{intro}}\n\nSeu código de verificação: {{code}}\n\nVálido por {{validity_minutes}} minutos, para uso único.\nDigite o código na tela do Vet Tech onde você fez a solicitação.\n\nNão compartilhe este código. Nossa equipe nunca pede sua senha ou seu código de verificação por mensagem.\n\nDesenvolvedores do Sistema:\nDavi Diniz · Vitor Sousa · Danikelly Alves\n\nNão foi você? Ignore este e-mail. Esta solicitação, por si só, não altera sua senha.\n\nVet Tech · Segurança e cuidado em cada etapa.\nEsta é uma mensagem automática.\nCopyright © by Vet Tech Team\n";
const p=$input;
if(!Object.hasOwn(config.purposes,p.purpose)||typeof p.code!=='string'||!/^\d{6}$/.test(p.code)||!Number.isInteger(p.validity_minutes)||p.validity_minutes<1||p.validity_minutes>60)throw Error('Mensagem inválida.');
for(const k of ['brand_color','background_color','text_color'])if(!/^#[0-9a-fA-F]{6}$/.test(config[k]))throw Error('Cor inválida.');
for(const key of ['header_image_url','footer_image_url','davi_image_url','vitor_image_url','danikelly_image_url','ocean_image_url'])if(!/^https:\/\/[a-z0-9.-]+(?::[0-9]+)?\/[^\s"<>]*$/i.test(config[key]))throw Error('URL da imagem inválida.');
const values={...config,...config.purposes[p.purpose],code:p.code,validity_minutes:String(p.validity_minutes)};
const escape=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#x27;'}[c]));
const render=(source,safe)=>source.replace(/\{\{([a-z_]+)\}\}/g,(_,key)=>{if(typeof values[key]!=='string')throw Error('Variável inválida.');return safe?escape(values[key]):values[key];});
return {subject:values.subject,html:render(template,true),text:render(plain,false)};
        """
      timeout = 5
    } as $message
  }
  response = $message
  history = false
  tags = ["vettech", "password-security"]
}
